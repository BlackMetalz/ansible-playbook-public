# General config
bind 0.0.0.0
protected-mode no
port {{ sentinel_port }}
daemonize yes
supervised systemd
pidfile "/run/sentinel/redis-sentinel-{{redis_port}}.pid"
loglevel notice
logfile "{{ sentinel_log }}"
dir "{{ data_dir }}"
acllog-max-len 128
requirepass {{ redis_password }}


# Sentinel Config 
sentinel deny-scripts-reconfig yes
sentinel resolve-hostnames no
sentinel announce-hostnames no
# We don't use notification script duo duplication. We use check_log plugin in CMK to handle this fucking event!
# sentinel notification-script {{ sentinel_name }} /opt/notify_redis_{{ redis_port }}.py
# Sentinel important config
sentinel monitor {{ sentinel_name }} {{ master_host }} {{ redis_port }} 2
sentinel auth-pass {{ sentinel_name }} {{ redis_password }}
sentinel down-after-milliseconds {{ sentinel_name }} {{ down_after_milliseconds }}
sentinel failover-timeout {{ sentinel_name }} {{ failover_timeout }}
sentinel parallel-syncs {{ sentinel_name }} 1
